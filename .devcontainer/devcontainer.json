{
  "name": "ROS 2 Jazzy Student Lab",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },

  "remoteUser": "ubuntu",
  "runArgs": ["--shm-size=1g"],

  "hostRequirements": { "cpus": 4, "memory": "16gb" },

  "remoteEnv": {
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST"
  },

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "ROS Desktop (RViz / Gazebo / turtlesim)",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "redhat.vscode-xml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.analysis.extraPaths": ["/opt/ros/jazzy/lib/python3.12/site-packages"],
        "files.exclude": { "build": true, "install": true, "log": true }
      }
    }
  }
}
