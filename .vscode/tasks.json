{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon: build",
      "type": "shell",
      "command": "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install",
      "group": { "kind": "build", "isDefault": true },
